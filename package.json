{
  "name": "taghvim-mcp",
  "version": "3.0.1",
  "description": "Deterministic temporal reasoning engine for AI agents — date/time arithmetic, timezone conversion, calendar systems, holidays, business days, and recurrence",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "taghvim-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test dist/index.test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "temporal",
    "date-time",
    "calendar",
    "jalali",
    "persian",
    "solar-hijri",
    "shamsi",
    "iranian-calendar",
    "timezone",
    "tz",
    "iana",
    "holidays",
    "public-holidays",
    "business-days",
    "working-days",
    "rrule",
    "recurrence",
    "rfc5545",
    "icalendar",
    "date-arithmetic",
    "ai-agent",
    "llm",
    "agent-tool",
    "deterministic",
    "iso8601",
    "rfc3339",
    "utc",
    "dst",
    "daylight-saving",
    "luxon",
    "chrono",
    "intl",
    "locale",
    "formatting",
    "temporal-reasoning",
    "date-parsing",
    "natural-language-date",
    "schedule",
    "recurring",
    "week-number",
    "iso-week"
  ],
  "author": "mj.yahaghi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfelfel/taghvim"
  },
  "bugs": {
    "url": "https://github.com/mrfelfel/taghvim/issues"
  },
  "homepage": "https://github.com/mrfelfel/taghvim#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "skills",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "Dockerfile"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrono-node": "^2.7.7",
    "date-holidays": "^3.36.0",
    "jalali-moment": "^3.3.1",
    "luxon": "^3.5.0",
    "rrule": "^2.8.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
